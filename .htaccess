# ==============================================================================
# Numbrix.app / Virtual Number Hub - Web Server & Security Configuration
# ==============================================================================

# Enable Rewrite Engine for HTTP to HTTPS Redirection
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS Protocol
    # Redirect all non-encrypted HTTP traffic to HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Canonical Domain Redirection (Optional www to non-www)
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ==============================================================================
# CRITICAL SECURITY HEADERS (Protection against Web Vulnerabilities)
# ==============================================================================
<IfModule mod_headers.c>
    # 1. HTTP Strict Transport Security (HSTS)
    # Forces browsers to only connect via HTTPS for 1 year (31,536,000 seconds)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 2. Content Security Policy (CSP)
    # Controls resources (scripts, styles, images) allowed to load and execute
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-ancestors 'none';"

    # 3. X-Content-Type-Options
    # Prevents Internet Explorer and Chrome from MIME-sniffing a response away from declared content-type
    Header always set X-Content-Type-Options "nosniff"

    # 4. X-Frame-Options
    # Prevents clickjacking by blocking rendering within iframes on third-party sites
    Header always set X-Frame-Options "SAMEORIGIN"

    # 5. X-XSS-Protection
    # Enables XSS filtering in browsers
    Header always set X-XSS-Protection "1; mode=block"

    # 6. Referrer-Policy
    # Restricts sensitive referrer data sent in cross-origin requests
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # 7. Permissions-Policy
    # Restricts access to browser device capabilities
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=()"

    # 8. Cache-Control & Security for Static HTML Assets
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# ==============================================================================
# SERVER SECURITY & FILE PROTECTION
# ==============================================================================

# Disable Directory Browsing
Options -Indexes -MultiViews

# Block Access to Hidden & Sensitive Files (.git, .env, .htaccess, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Allow Root Index Access
DirectoryIndex index.html
